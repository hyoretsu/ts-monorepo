{
	"name": "sql",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./typebox": "./out/typebox/barrel.ts"
	},
	"scripts": {
		"check-types": "bun check",
		"export": "prisma contract emit && bun scripts/generate-typebox.ts out/prisma/contract.json out/typebox",
		"migrate": "prisma migration plan",
		"migrate:deploy": "prisma db migrate --to @contract",
		"migrate:dev": "bun run export && prisma migration plan && prisma db migrate --to @contract",
		"seed": "bun src/seed/index.ts",
		"test:integration": "bun ../../scripts/test-runner.ts sql integration",
		"test:e2e": "bun ../../scripts/test-runner.ts sql e2e"
	},
	"dependencies": {
		"@prisma/orm-postgres": "8.0.0-rc.22",
		"dotenv": "^17.4.2",
		"elysia": "^1.4.28",
		"pg": "^8.21.0"
	},
	"devDependencies": {
		"@hyoretsu/configs": "^1.2.33",
		"@types/node": "^25.9.1",
		"@types/pg": "8.20.4",
		"prisma": "8.0.0-rc.29"
	}
}
