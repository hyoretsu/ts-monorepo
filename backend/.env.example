API_URL='http://localhost:3333'
APP_URL='http://localhost:3000'
CORS_WHITELIST='*'
BETTER_AUTH_SECRETS=''
BETTER_AUTH_URL="$API_URL"
# Dedicated database for E2E tests (must already exist; never the dev DB)
DATABASE_TEST_URL='postgresql://postgres:postgres@localhost:5432/example_test'
DATABASE_URL='postgresql://postgres:postgres@localhost:5432/example'
MAIL_HOST=''
MAIL_PASS=''
MAIL_PORT=''
MAIL_USER=''
NODE_ENV='development'
PORT=3333
RABBITMQ_URL='amqp://guest:guest@127.0.0.1:5672'
REDIS_URL='redis://127.0.0.1:6379'
RESEND_API_KEY=''
S3_ACCESS_KEY_ID=''
S3_BUCKET=''
S3_ENDPOINT=''
S3_PREFIX=''
S3_SECRET_ACCESS_KEY=''
SERVICE_NAMESPACE='template_dev'
STATIC_DIR=''

# Providers
MAIL_DRIVER=nodemailer
STORAGE_DRIVER=s3

# OpenTelemetry: enabled automatically when a Collector endpoint is set (leave empty to disable).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_LOG_LEVEL=info
OTEL_CAPTURE_SUMMARIES=false
# Safety limits per request: function spans beyond them run uninstrumented and the root span gets
# application.truncated. Both are capped at 32 / 1000; these variables can only lower them.
OTEL_FUNCTION_MAX_DEPTH=32
OTEL_FUNCTION_MAX_SPANS=1000
OTEL_CLIENT_VERSIONS=development
