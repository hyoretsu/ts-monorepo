# syntax=docker/dockerfile:1.7

FROM oven/bun:1.4.3 AS deps

WORKDIR /app

COPY package.json bun.lock ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY packages/sql/package.json packages/sql/package.json
COPY packages/domain/package.json packages/domain/package.json

RUN bun i --frozen-lockfile --linker=isolated --ignore-scripts

FROM deps AS build

WORKDIR /app

ARG VARIANT
ENV VARIANT=${VARIANT}
ARG NODE_ENV=production
ENV NODE_ENV=${NODE_ENV}

COPY . .

# Database branding can change independently of source or selection.
ARG BRANDING_REVISION
RUN --mount=type=secret,id=DATABASE_URL,env=DATABASE_URL bunx turbo -F backend build

FROM oven/bun:1.4.3 AS runtime

WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/backend/node_modules ./backend/node_modules
COPY --from=build /app/packages/sql/node_modules ./packages/sql/node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/backend/package.json /app/backend/tsconfig.json ./backend/
COPY --from=build /app/packages/sql/package.json ./packages/sql/
COPY --from=build /app/backend/dist ./backend/dist
COPY --from=build /app/packages/sql/out ./packages/sql/out
COPY --from=build /app/packages/sql/src ./packages/sql/src
COPY --from=build /app/packages/domain ./packages/domain

WORKDIR /app/backend

RUN mkdir -p static

EXPOSE 3333

CMD ["bun", "dist/worker.js"]
