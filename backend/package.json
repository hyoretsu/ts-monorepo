{
	"name": "backend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun scripts/build.ts",
		"check-types": "bun check",
		"dev": "bun run --parallel dev:api dev:worker",
		"export": "bun ./src/generateOpenApi.ts",
		"start": "NODE_ENV=production bun dist/main.js",
		"dev:api": "bun --preload ./scripts/otel-preload.ts --watch src/main.ts",
		"dev:worker": "bun --preload ./scripts/otel-preload.ts --watch src/worker.ts",
		"start:worker": "NODE_ENV=production bun dist/worker.js",
		"test:integration": "bun ../scripts/test-runner.ts backend integration",
		"test:e2e": "bun ../scripts/test-runner.ts backend e2e",
		"variant:prepare": "bun ../scripts/prepare-variant.ts"
	},
	"dependencies": {
		"@elysiajs/openapi": "^1.4.15",
		"@elysiajs/static": "^1.4.10",
		"@hyoretsu/utils": "^1.18.1",
		"@react-email/components": "^1.0.12",
		"@sinclair/typebox": "^0.34.49",
		"@types/nodemailer": "^8.0.0",
		"better-auth": "^1.6.14",
		"elysia": "^1.4.28",
		"elysia-ip": "^1.1.0",
		"es-toolkit": "^1.47.0",
		"http-status-codes": "^2.3.0",
		"ky": "^2.0.2",
		"nodemailer": "^8.0.10",
		"permix": "^3.8.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"sql": "workspace:*",
		"amqplib": "^0.10.9",
		"@template/domain": "workspace:*",
		"@template/observability": "workspace:*"
	},
	"devDependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@hyoretsu/configs": "^1.2.33",
		"@types/bun": "^1.3.14",
		"@types/http-status-codes": "^1.2.0",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.16",
		"@types/react-dom": "^19.2.3",
		"typescript": "^6.0.3",
		"@types/amqplib": "^0.10.8",
		"@types/pg": "8.20.4",
		"dotenv": "^17.4.2",
		"pg": "^8.21.0",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/context-async-hooks": "^3.0.0",
		"@opentelemetry/core": "^3.0.0",
		"@opentelemetry/sdk-trace": "3.0.0"
	}
}
