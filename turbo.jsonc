{
	"$schema": "https://turborepo.dev/schema.json",
	"globalEnv": ["VARIANT"],
	"globalPassThroughEnv": ["DATABASE_URL"],
	"tasks": {
		"build": {
			"cache": false,
			"dependsOn": ["^export", "generate", "variant:prepare"],
			"env": ["VITE_API_URL", "VITE_APP_URL"],
			"inputs": ["$TURBO_DEFAULT$", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["build/**", "dist/**", "out/**", ".next/**", "!.next/cache/**"]
		},
		"check-types": {
			"cache": false,
			"dependsOn": ["^export", "generate", "variant:prepare"],
			"inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"],
			"outputLogs": "new-only"
		},
		"dev": {
			"cache": false,
			"dependsOn": ["^export", "generate", "variant:prepare"],
			"persistent": true
		},
		"export": {
			"cache": false,
			"dependsOn": ["^export", "generate", "variant:prepare"],
			"env": ["DATABASE_URL"],
			"inputs": ["$TURBO_DEFAULT$", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["out/**"]
		},
		"frontend#generate": {
			"dependsOn": ["^export"],
			"inputs": ["kubb.config.ts", "../backend/out/openapi.json"],
			"outputLogs": "new-only",
			"outputs": ["src/lib/api/generated/**"]
		},
		"generate": {
			"dependsOn": ["^export"],
			"env": ["DATABASE_URL"],
			"inputs": ["$TURBO_DEFAULT$", "!src/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["src/generated/**"]
		},
		"migrate:deploy": {
			"env": ["DATABASE_URL", "DATABASE_TEST_URL"],
			"inputs": ["src/migrations/**"],
			"outputLogs": "new-only"
		},
		"test": {
			"dependsOn": ["test:integration", "test:e2e"]
		},
		"test:e2e": {
			"cache": false,
			"dependsOn": ["^export"]
		},
		"test:integration": {
			"cache": false,
			"dependsOn": ["^export"]
		},
		"variant:prepare": {
			"cache": false,
			"dependsOn": ["^export"],
			"env": ["VARIANT", "DATABASE_URL"]
		}
	}
}
