		"@tauri-apps/plugin-deep-link": "~2.4.9",
		"@tauri-apps/plugin-opener": "^2.5.0",
		"@template/domain": "workspace:*",
		"better-auth": "^1.6.14",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.5.0",
