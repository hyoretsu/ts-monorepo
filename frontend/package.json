{
	"name": "frontend",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build && tsc -b",
		"check-types": "tsc --noEmit",
		"dev": "vite --host",
		"preview": "vite preview",
		"start": "vite preview",
		"tauri": "tauri",
		"tauri:android": "tauri android dev",
		"tauri:build": "tauri build",
		"tauri:dev": "tauri dev",
		"tauri:ios": "tauri ios dev",
		"generate": "KUBB_DISABLE_TELEMETRY=1 kubb generate",
		"links:generate": "bun scripts/generate-app-links.ts",
		"build:associated": "bun run links:generate --strict && bun run build",
		"test:e2e": "playwright test",
		"performance:test": "playwright test --config playwright.performance.config.ts",
		"tauri:build:associated": "bun run links:generate --strict && tauri build --config src-tauri/tauri.links.conf.json"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
