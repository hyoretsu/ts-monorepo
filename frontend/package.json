		"i18next": "^26.3.1",
		"i18next-browser-languagedetector": "^8.2.1",
		"ky": "^2.0.2",
		"next-themes": "^0.4.6",
		"nuqs": "^2.8.9",
		"radix-ui": "^1.4.3",
		"react": "^19.2.7",
		"react-day-picker": "^10.0.2",
		"react-dom": "^19.2.7",
		"react-i18next": "^17.0.8",
