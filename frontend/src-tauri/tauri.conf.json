{
	"$schema": "https://schema.tauri.app/config/2",
	"app": {
		"security": {
			"capabilities": [
				{
					"identifier": "main-capability",
					"permissions": ["core:default", "deep-link:default", "opener:default"],
					"windows": ["main"]
				}
			],
			"csp": null
		},
		"windows": [
			{
				"fullscreen": false,
				"height": 800,
				"resizable": true,
				"title": "Example",
				"width": 400
			}
		],
		"withGlobalTauri": true
	},
	"build": {
		"beforeBuildCommand": "bun run build",
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:5173",
		"frontendDist": "../dist"
	},
	"bundle": {
		"active": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"targets": "all"
	},
	"identifier": "com.example.app",
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["template"]
			}
		}
	},
	"productName": "Example",
	"version": "1.0.0"
}
