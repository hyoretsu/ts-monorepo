{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"extends": ["@hyoretsu/configs/biome"],
	"formatter": {
		"enabled": false
	},
	"linter": {
		"rules": {
			"nursery": {
				"useSortedClasses": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.jsonc"],
			"json": {
				"parser": {
					"allowComments": true,
					"allowTrailingCommas": true
				}
			}
		}
	]
}
