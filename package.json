{
	"name": "template",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"backend",
		"frontend",
		"packages/*"
	],
	"scripts": {
		"build": "turbo build",
		"check-types": "turbo check-types",
		"commit": "git add . && bun committier ai",
		"dev": "turbo dev",
		"format": "bun fmt",
		"prepare": "bun run ./prepare.ts || true",
		"start": "turbo start",
		"test": "bun run test:integration && bun run test:e2e",
		"test:e2e": "bun scripts/test-runner.ts backend e2e && bun scripts/test-runner.ts sql e2e",
		"test:integration": "bun scripts/test-runner.ts backend integration && bun scripts/test-runner.ts sql integration",
		"format:check": "bun fmt --check",
		"lint": "bun run lint:biome . && bun run lint:eslint .",
		"lint:biome": "bunx biome check --formatter-enabled=false --diagnostic-level=error",
		"lint:eslint": "bunx eslint --quiet",
		"lint:fix": "bun run lint:biome --write --unsafe . && bun run lint:eslint --fix . && bun run format"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@commitlint/types": "^20.5.0",
		"@eslint/js": "^10.0.1",
		"@hyoretsu/configs": "^1.2.33",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.9.1",
		"committier": "^0.2.3",
		"eslint": "^10.4.1",
		"eslint-config-biome": "^2.1.3",
		"lefthook": "^2.1.9",
		"lint-staged": "^16.4.0",
		"turbo": "^2.9.16",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1"
	}
}
